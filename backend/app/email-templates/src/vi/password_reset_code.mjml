<mjml>
  <mj-body background-color="#f5f7fb">
    <mj-section padding="24px 12px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" color="#111827" align="center">
          {{project_name}} - Đặt lại mật khẩu
        </mj-text>
        <mj-text font-size="14px" color="#475569" align="center">
          Xin chào {{user_name}}, hệ thống nhận được yêu cầu đặt lại mật khẩu cho tài khoản <strong>{{email}}</strong>.
        </mj-text>
        <mj-spacer height="12px" />
        <mj-text font-size="14px" color="#475569" align="center">
          Vui lòng nhập mã 6 số sau để tiếp tục:
        </mj-text>
        <mj-text font-size="34px" font-weight="800" letter-spacing="6px" color="#0f172a" align="center">
          {{code}}
        </mj-text>
        <mj-text font-size="13px" color="#64748b" align="center">
          Mã có hiệu lực trong {{ttl_minutes}} phút. Nếu bạn không yêu cầu, hãy bỏ qua email này.
        </mj-text>
        <mj-divider border-color="#e2e8f0" />
        <mj-text font-size="12px" color="#94a3b8" align="center">
          Mã người dùng: {{user_code}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
