<mjml>
  <mj-body background-color="#f5f7fb">
    <mj-section padding="24px 0">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#0f172a">
          Payment successful
        </mj-text>
        <mj-text font-size="14px" color="#334155">
          Hi {{ user_name }},
        </mj-text>
        <mj-text font-size="14px" color="#334155">
          We have received your payment for invoice <strong>{{ invoice_id }}</strong>.
        </mj-text>
        <mj-divider border-color="#e2e8f0" />
        <mj-text font-size="14px" color="#0f172a">
          <strong>Amount:</strong> {{ amount_text }} VND
        </mj-text>
        <mj-text font-size="14px" color="#0f172a">
          <strong>Subscription:</strong> {{ start_date }} – {{ end_date }}
        </mj-text>
        <mj-divider border-color="#e2e8f0" />
        <mj-text font-size="13px" color="#64748b">
          If you need help, please reply to this email.
        </mj-text>
        <mj-text font-size="13px" color="#64748b">
          Regards,<br />
          {{ project_name }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

